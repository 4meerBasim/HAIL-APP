# Where the app finds the Laravel API (JAREESH-API).
#
# On a device this must be the Mac's LAN address. "localhost" is the phone
# itself, so the request never leaves the handset and reads as the server being
# down. Find yours with: ipconfig getifaddr en0
#
# Copy this file to .env.local and set the value. .env.local is gitignored;
# this one is committed so a new machine knows what to set.
EXPO_PUBLIC_API_URL=http://192.168.68.58:8100
